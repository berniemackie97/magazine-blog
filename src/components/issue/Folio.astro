---
interface Props {
  page: number;
  side: "left" | "right";
  label?: string;
}

const { page, side, label } = Astro.props;
---

<div class:list={["folio", "mono-label", side]} aria-hidden="true">
  <span>{String(page).padStart(2, "0")}</span>
  {label && <span>{label}</span>}
</div>

<style>
  .folio {
    position: absolute;
    left: clamp(20px, 4vw, 44px);
    right: clamp(20px, 4vw, 44px);
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--page-muted);
  }

  .right {
    flex-direction: row-reverse;
  }
</style>
