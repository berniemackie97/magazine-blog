---
import type { Identity } from "../../lib/studio/auth";
interface Props {
  user: Identity;
}
const { user } = Astro.props;
---

<div class="studio" id="studio">
  <aside class="sidebar" aria-label="Studio navigation">
    <a class="studio-brand" href="/studio"
      ><span class="brand-icon" aria-hidden="true">R.</span><span
        >The Rack<small>EDITORIAL STUDIO</small></span
      ></a
    >
    <div class="workspace-label">
      <span class="live-dot"></span> Your publishing desk
    </div>
    <nav class="studio-nav" aria-label="Content">
      <button type="button" data-view="posts" aria-current="page"
        ><span aria-hidden="true">▤</span> Articles <span
          class="nav-count"
          id="count-posts">—</span
        ></button
      >
      <button type="button" data-view="issues"
        ><span aria-hidden="true">▥</span> Issues <span
          class="nav-count"
          id="count-issues">—</span
        ></button
      >
      <button type="button" data-view="publications"
        ><span aria-hidden="true">▦</span> Publications <span
          class="nav-count"
          id="count-publications">—</span
        ></button
      >
      <button type="button" data-view="media"
        ><span aria-hidden="true">▧</span> Media library</button
      >
      <button type="button" data-view="release"
        ><span aria-hidden="true">↗</span> Release desk</button
      >
    </nav>
    <div class="sidebar-bottom">
      <a href="/" target="_blank" rel="noopener noreferrer"
        >Visit the newsstand ↗</a
      ><div class="identity">
        <span class="avatar">{user.login.slice(0, 1).toUpperCase()}</span><span
          >{user.login}<small
            >{user.local ? "Local workspace" : "GitHub workspace"}</small
          ></span
        >{
          !user.local && (
            <form action="/api/studio/auth/logout" method="post">
              <button class="text-button" type="submit">
                Sign out
              </button>
            </form>
          )
        }
      </div>
    </div>
  </aside>
  <div class="studio-main">
    <header class="studio-topbar">
      <div>
        <span class="eyebrow">THE RACK / STUDIO</span><h1 id="view-title">
          Articles
        </h1>
      </div><div class="topbar-actions">
        <span id="connection" class="connection" role="status">Connecting…</span
        ><button id="refresh" class="button secondary" type="button"
          >Refresh</button
        ><button id="new-entry" class="button primary" type="button"
          >+ New article</button>
      </div>
    </header>
    <div id="notice" class="notice" role="status" hidden></div>
    <main id="workspace" tabindex="-1">
      <section id="listing" aria-label="Content library">
        <div class="collection-intro">
          <div>
            <h2 id="collection-heading">Stories worth putting on paper.</h2><p
              id="collection-description"
            >
              Draft, refine, and prepare your next release.
            </p>
          </div><span class="collection-mark" aria-hidden="true">Aa</span>
        </div>
        <div class="filterbar">
          <label class="search-label"
            ><span class="visually-hidden">Search content</span><input
              type="search"
              id="search"
              placeholder="Search by title, publication, or tag…"
            /></label
          ><label
            ><span class="visually-hidden">Filter status</span><select
              id="status-filter"
              ><option value="all">All statuses</option><option value="draft"
                >Drafts</option
              ><option value="published">Ready / published</option></select
            ></label
          ><label
            ><span class="visually-hidden">Sort content</span><select id="sort"
              ><option value="date">Newest first</option><option value="title"
                >Title A–Z</option
              ></select
            ></label>
        </div>
        <div id="entry-list" class="entry-list" aria-live="polite">
          <p class="empty-state">Loading your content…</p>
        </div>
      </section>
      <section id="editor" hidden aria-label="Content editor">
        <div class="editor-toolbar">
          <button id="back" class="text-button" type="button"
            >← Back to articles</button
          ><div>
            <span id="save-status" role="status">All changes saved</span><button
              id="history"
              class="button secondary"
              type="button">History</button
            ><button id="preview" class="button secondary" type="button"
              >Preview ↗</button
            ><button id="save" class="button primary" type="button"
              >Save changes</button>
          </div>
        </div>
        <div id="recovery" class="recovery" hidden>
          <p>A recovered draft is available from this browser.</p><button
            type="button"
            id="recover"
            class="button secondary">Recover edits</button
          ><button type="button" id="discard-recovery" class="text-button"
            >Discard recovery</button>
        </div>
        <form id="entry-form" novalidate>
          <div class="editor-heading">
            <span class="eyebrow" id="editor-kind">ARTICLE</span><h2
              id="editor-title"
            >
              Untitled
            </h2><p id="editor-url" class="muted"></p>
          </div>
          <div id="fields" class="metadata-grid"></div>
          <section id="body-editor" class="body-editor">
            <div
              class="writing-tools"
              role="toolbar"
              aria-label="Article formatting"
            >
              <button type="button" data-format="heading" title="Heading"
                >H2</button
              ><button type="button" data-format="bold" title="Bold"
                ><strong>B</strong></button
              ><button type="button" data-format="italic" title="Italic"
                ><em>I</em></button
              ><button type="button" data-format="link">Link</button><button
                type="button"
                data-format="code">Code</button
              ><button type="button" data-format="list">List</button><span
                class="toolbar-divider"></span><button
                type="button"
                id="insert-component">+ Content block</button
              ><button type="button" id="insert-image">+ Image</button><span
                id="word-count"
                class="word-count">0 words</span>
            </div>
            <label for="article-body" class="visually-hidden"
              >Article body in Markdown and MDX</label
            ><textarea
              id="article-body"
              spellcheck="true"
              placeholder="Start with something worth sharing…"></textarea>
            <div class="writing-footer">
              <span>Markdown + your magazine components</span><span
                >⌘ / Ctrl + S to save</span>
            </div>
          </section>
          <div id="issue-articles" class="issue-articles" hidden></div>
          <div class="editor-footer">
            <p class="muted">
              Saving updates your workspace. Publishing is a separate release.
            </p><button
              id="delete-entry"
              class="text-button danger"
              type="button">Delete entry</button>
          </div>
        </form>
      </section>
      <section id="media-panel" hidden aria-label="Media library">
        <div class="collection-intro">
          <div>
            <h2>A place for the pictures.</h2><p>
              Upload images, copy their paths, and add them to your stories.
            </p>
          </div><label class="button primary upload-label"
            >Upload images<input
              type="file"
              id="media-upload"
              accept="image/png,image/jpeg,image/webp"
              multiple
              hidden
            /></label>
        </div><p class="muted">
          Up to 8 MB per image. Images are resized to at most 2400 pixels wide
          and saved as WebP.
        </p><div id="media-grid" class="media-grid"></div>
      </section>
      <section id="release-panel" hidden aria-label="Release desk">
        <div class="collection-intro">
          <div>
            <h2>Ready for the rack?</h2><p>
              Validate your workspace, review the release, then put it in
              readers’ hands.
            </p>
          </div><span class="collection-mark" aria-hidden="true">↗</span>
        </div><div class="release-grid">
          <div class="release-card">
            <span class="eyebrow">01 / PREPARE</span><h3>
              Check the complete edition
            </h3><p>
              Validate article syntax, publication sections, and issue
              relationships.
            </p><button type="button" id="validate" class="button secondary"
              >Validate workspace</button>
          </div><div class="release-card">
            <span class="eyebrow">02 / RELEASE</span><h3>
              Give this release a name
            </h3><label class="field"
              ><span>Release title</span><input
                id="release-title"
                maxlength="120"
                value="Publish editorial updates"
                required
              /></label
            ><p id="release-explanation"></p><button
              id="submit-release"
              type="button"
              class="button primary">Prepare release</button>
          </div>
        </div><section class="release-status">
          <div class="section-heading">
            <h3>Release status</h3><button
              type="button"
              id="refresh-release"
              class="text-button">Refresh status</button>
          </div><p id="release-message">No release submitted.</p><ul
            id="release-checks"
          >
          </ul><a
            id="release-link"
            class="button secondary"
            target="_blank"
            rel="noopener noreferrer"
            hidden>Review release on GitHub ↗</a
          ><button
            id="publish-release"
            class="button primary"
            type="button"
            hidden>Publish reviewed release</button>
        </section><div id="release-summary"></div>
      </section>
    </main>
    <footer class="studio-footer">
      <span>Made for The Rack.</span><span id="workspace-detail"
        >Your words. Your files. Your publication.</span>
    </footer>
  </div>
</div>
