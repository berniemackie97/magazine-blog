---
import { site } from "../../config/site";
import { urls } from "../../lib/urls";
---

<footer class="site-footer">
  <div class="inner">
    <span class="name">{site.name.toUpperCase()}</span>
    <p class="hours">open late, restocked when it's ready.</p>
    <nav aria-label="Footer">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={urls.feed()}>RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--ink);
    color: var(--paper);
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .hours {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.375rem;
    color: var(--lemon);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 0.375rem;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  a:hover {
    color: var(--lemon);
  }
</style>
