---
import { resolveVideo } from "../../lib/video";

interface Props {
  src?: string;
  title?: string;
  caption?: string;
  poster?: string;
  placeholder?: string;
}

const { src, title = "Video", caption, poster, placeholder = "Video coming soon." } = Astro.props;
const video = resolveVideo(src);
---

<figure class="video">
  <div class="frame">
    {
      video.kind === "embed" && (
        <iframe
          src={video.src}
          title={title}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="encrypted-media; picture-in-picture; fullscreen"
          allowfullscreen
        />
      )
    }
    {
      video.kind === "file" && (
        <video controls preload="metadata" poster={poster}>
          <source src={video.src} />
        </video>
      )
    }
    {video.kind === "none" && <p class="placeholder">{placeholder}</p>}
  </div>
  {
    (title || caption) && (
      <figcaption>
        <strong>{title}</strong>
        {caption && <span> · {caption}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .video {
    margin: 2.5rem 0;
  }

  .frame {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background: #000;
    border: 1px solid var(--page-border);
  }

  iframe,
  video {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .placeholder {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    color: #c9b79f;
  }

  figcaption {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--page-muted);
  }
</style>
