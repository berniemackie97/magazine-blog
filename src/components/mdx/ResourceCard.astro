---
/** A classified-ad style listing for an external tool or resource. */
import type { ComponentProps } from "../../lib/content/component-schema";
type Props = ComponentProps<"ResourceCard">;

const {
  title,
  href,
  summary,
  badge,
  tone,
  meta,
  tags = [],
  altSources = [],
} = Astro.props;
const external = /^https?:\/\//.test(href);
const linkAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<li class="ad" data-tone={tone}>
  <a class="main" href={href} {...linkAttrs}>
    <span class="head mono-label">
      {badge && <span class="badge">{badge}</span>}
      {meta && <span class="meta">{meta}</span>}
    </span>
    <span class="title">{title}</span>
    {summary && <span class="summary">{summary}</span>}
    {
      tags.length > 0 && (
        <span class="resource-tags">
          {tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </span>
      )
    }
    {external && <span class="visually-hidden">(opens in a new tab)</span>}
  </a>
  {
    altSources.length > 0 && (
      <div class="alts">
        <span class="mono-label">Also</span>
        {altSources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener noreferrer">
            {source.label}
            {source.note && <span class="note"> ({source.note})</span>}
          </a>
        ))}
      </div>
    )
  }
</li>

<style>
  .resource-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    font-size: 0.65rem;
    color: var(--page-muted);
  }
  .resource-tags span {
    padding: 2px 5px;
    border: 1px solid var(--page-border);
    border-radius: 3px;
  }
  .ad {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--page-border);
    background: var(--page-bg);
    transition:
      border-color 200ms,
      transform 200ms;
  }

  .ad:hover {
    border-color: var(--page-accent);
    transform: translateY(-2px);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 14px 12px;
    text-decoration: none;
    color: var(--page-text);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: 0.6875rem;
  }

  .badge {
    color: var(--page-muted);
  }

  .ad[data-tone="free"] .badge {
    color: #3fb950;
  }

  .ad[data-tone="paid"] .badge {
    color: #e3b341;
  }

  .ad[data-tone="freemium"] .badge {
    color: #79c0ff;
  }

  .meta {
    color: var(--page-muted);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.15;
  }

  .summary {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .alts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    padding: 10px 14px;
    border-top: 1px dashed var(--page-border);
    font-size: 0.8125rem;
  }

  .alts .mono-label {
    font-size: 0.625rem;
    color: var(--page-muted);
  }

  .alts a {
    color: var(--page-accent);
  }

  .note {
    color: var(--page-muted);
  }
</style>
