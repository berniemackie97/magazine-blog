---
import ArticleFooterNav from "../../components/article/ArticleFooterNav.astro";
import ArticleHeader from "../../components/article/ArticleHeader.astro";
import ArticleRail from "../../components/article/ArticleRail.astro";
import Prose from "../../components/article/Prose.astro";
import ReadingProgress from "../../components/article/ReadingProgress.astro";
import Folio from "../../components/issue/Folio.astro";
import Container from "../../components/site/Container.astro";
import HandLink from "../../components/site/HandLink.astro";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { startPages } from "../../lib/content/folio";

import type { Post, Publication, Issue } from "../../lib/content/types";
import { urls } from "../../lib/urls";

interface Props {
  post: Post;
  publication: Publication;
  issue?: Issue;
  siblings: Post[];
  headings: { depth: number; slug: string; text: string }[];
  preview?: boolean;
}
const {
  post,
  publication,
  issue,
  siblings,
  headings,
  preview = false,
} = Astro.props;
const index = siblings.findIndex((p) => p.id === post.id);
const previous = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 ? siblings[index + 1] : undefined;
const page = startPages(siblings).get(post.id) ?? 1;

const backHref = issue
  ? urls.issue(publication.id, issue.slug)
  : urls.publication(publication.id);
const backLabel = issue
  ? `back to ${issue.title} contents`
  : `back to ${publication.name}`;
---

<BaseLayout
  title={`${post.headline} · ${publication.name}`}
  description={post.summary || post.dek}
  publication={publication}
  backdrop="counter"
  ogType="article"
  preview={preview}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedAt} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <ReadingProgress />
  <Container>
    <HandLink href={backHref}>← {backLabel}</HandLink>

    <article class="page">
      <ArticleHeader post={post} publication={publication} issue={issue} />
      <div class="layout">
        <div class="body">
          <Prose><slot /></Prose>
        </div>
        <div class="rail">
          <ArticleRail
            headings={headings}
            tags={post.tags}
            issue={issue}
            publicationId={publication.id}
          />
        </div>
      </div>
      <Folio
        page={page}
        side={page % 2 === 0 ? "left" : "right"}
        label={`${site.name} · ${publication.name}`}
      />
    </article>

    <ArticleFooterNav
      previous={previous}
      next={next}
      back={{
        href: backHref,
        label: "← flip back",
        title: issue ? `${issue.title} contents` : publication.name,
      }}
      onward={{
        href: urls.home(),
        label: "grab another off the rack →",
        title: "Back to the rack",
      }}
    />
  </Container>
</BaseLayout>

<style>
  .page {
    position: relative;
    margin-top: 16px;
    padding: 32px clamp(20px, 5vw, 64px) 72px;
    background: var(--page-bg);
    color: var(--page-text);
    box-shadow: 0 40px 60px rgb(0 0 0 / 0.5);
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
    margin-top: 40px;
  }

  .body {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 760px;
  }

  .rail {
    flex: 1 1 200px;
    max-width: 260px;
    align-self: stretch;
  }

  @media (max-width: 900px) {
    .rail {
      max-width: none;
    }
  }
</style>
