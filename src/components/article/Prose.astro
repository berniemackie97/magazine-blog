---
/** Typography for rendered MDX. Markdown output isn't scoped, so rules are global under `.prose`. */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    font-family: var(--page-body-font);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--page-text);
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--page-heading-font);
    font-weight: 400;
    line-height: 1.05;
    scroll-margin-top: 24px;
  }

  .prose h2 {
    margin: 3rem 0 0.75rem;
    font-size: clamp(2rem, 4vw, 2.5rem);
    text-transform: uppercase;
  }

  .prose h3 {
    margin: 2rem 0 0.5rem;
    font-size: 1.5rem;
  }

  .prose p,
  .prose ul,
  .prose ol {
    margin: 0 0 1.25rem;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }

  .prose li::marker {
    color: var(--page-accent);
  }

  .prose a {
    color: var(--page-accent);
    text-underline-offset: 3px;
  }

  .prose strong {
    color: var(--page-text);
    font-weight: 700;
  }

  .prose hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--page-border);
  }

  .prose code {
    padding: 0.1em 0.35em;
    background: var(--page-surface);
    border: 1px solid var(--page-border);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose pre {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--page-border);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose pre code {
    padding: 0;
    background: none;
    border: 0;
  }

  .prose blockquote {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--page-accent);
    color: var(--page-muted);
  }

  .prose > p:first-of-type::first-letter {
    float: left;
    margin: 0.35rem 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: 4.6em;
    line-height: 0.8;
    color: var(--page-accent);
  }
</style>
