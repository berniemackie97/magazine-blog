---
import PublicationCard from "../../components/publication/PublicationCard.astro";
import Awning from "../../components/site/Awning.astro";
import Container from "../../components/site/Container.astro";
import PageHero from "../../components/site/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicationShelves } from "../../lib/content/rack";

const shelves = await getPublicationShelves({ featuredOnly: false });
---

<BaseLayout title="Publications" description="Every publication on The Rack, each with its own beat and its own look.">
  <Awning />
  <Container>
    <PageHero title="Subscriptions" highlight="desk." lede="Each publication has its own beat and its own look. Pick one and read the whole run." />
    <div class="grid">
      {shelves.map((shelf) => <PublicationCard shelf={shelf} />)}
    </div>
  </Container>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 40px 32px;
  }
</style>
