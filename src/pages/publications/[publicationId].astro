---
import type { GetStaticPaths } from "astro";
import PublicationDocument from "../../components/publication/PublicationDocument.astro";
import { getPostListings } from "../../lib/content/listings";
import { getPublications } from "../../lib/content/publications";
import { getShelfFor } from "../../lib/content/rack";
import type { Publication } from "../../lib/content/types";
export const getStaticPaths = (async () =>
  (await getPublications()).map((publication) => ({
    params: { publicationId: publication.id },
    props: { publication },
  }))) satisfies GetStaticPaths;
interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
const [shelf, listings] = await Promise.all([
  getShelfFor(publication),
  getPostListings({ publicationId: publication.id }),
]);
---

<PublicationDocument
  publication={publication}
  shelf={shelf}
  listings={listings}
/>
