---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import ArticleDocument from "../../components/article/ArticleDocument.astro";
import { mdxComponents } from "../../components/mdx";
import { findIssue } from "../../lib/content/issues";
import {
  byRunningOrder,
  getPosts,
  getPostsForIssue,
} from "../../lib/content/posts";
import { requirePublication } from "../../lib/content/publications";
import type { Post } from "../../lib/content/types";
export const getStaticPaths = (async () =>
  (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))) satisfies GetStaticPaths;
interface Props {
  post: Post;
}
const { post } = Astro.props;
const publication = await requirePublication(post.publicationId);
const issue = post.issueSlug
  ? await findIssue(publication.id, post.issueSlug)
  : undefined;
const siblings = issue
  ? (await getPostsForIssue(publication.id, issue.slug)).sort(byRunningOrder)
  : [];
const { Content, headings } = await render(post.entry);
---

<ArticleDocument
  post={post}
  publication={publication}
  issue={issue}
  siblings={siblings}
  headings={headings}><Content components={mdxComponents} /></ArticleDocument
>
