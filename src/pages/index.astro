---
import ArticleList from "../components/articles/ArticleList.astro";
import Newsprint from "../components/paper/Newsprint.astro";
import PinnedNote from "../components/paper/PinnedNote.astro";
import RackFrame from "../components/rack/RackFrame.astro";
import Shelf from "../components/rack/Shelf.astro";
import Awning from "../components/site/Awning.astro";
import Container from "../components/site/Container.astro";
import PageHero from "../components/site/PageHero.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostListings } from "../lib/content/listings";
import { getFreshShelf, getPublicationShelves } from "../lib/content/rack";
import { urls } from "../lib/urls";

const [fresh, shelves, latest] = await Promise.all([
  getFreshShelf(6),
  getPublicationShelves({ featuredOnly: true }),
  getPostListings({ limit: 5 }),
]);
---

<BaseLayout>
  <Awning />
  <Container>
    <PageHero title="In progress," highlight="in print." lede={`${site.description} Pull one off the rack.`}>
      <PinnedNote>Hey, I'm {site.author}. This is my devlog, printed one issue at a time.</PinnedNote>
    </PageHero>

    <RackFrame id="rack">
      <Shelf id="fresh" label="Fresh off the press" tone="lemon" items={fresh} />
      {
        shelves.map(({ publication, items }) => (
          <Shelf
            id={publication.id}
            label={publication.name}
            note={publication.kicker}
            items={items}
            moreHref={urls.publication(publication.id)}
          />
        ))
      }
    </RackFrame>

    {
      latest.length > 0 && (
        <div class="daily">
          <Newsprint id="daily" title="The Rack Daily" subtitle="Latest articles · every issue, every publication">
            <ArticleList listings={latest} />
            <a class="more" href={urls.archive()}>Read the full archive →</a>
          </Newsprint>
        </div>
      )
    }
  </Container>
</BaseLayout>

<style>
  .daily {
    margin-top: 72px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: 8px;
    font-weight: 700;
    font-size: 0.9375rem;
  }
</style>
