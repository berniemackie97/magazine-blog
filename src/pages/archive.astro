---
import ArchiveFilters from "../components/articles/ArchiveFilters.astro";
import ArticleList from "../components/articles/ArticleList.astro";
import Newsprint from "../components/paper/Newsprint.astro";
import Container from "../components/site/Container.astro";
import PageHero from "../components/site/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostListings } from "../lib/content/listings";
import { getPublications } from "../lib/content/publications";

const [listings, publications] = await Promise.all([getPostListings(), getPublications()]);

const unique = (values: string[]) => [...new Set(values)].sort();
const formats = unique(listings.map((l) => l.post.format)).map((value) => ({
  value,
  label: value.replace("-", " "),
}));
const tags = unique(listings.flatMap((l) => l.post.tags)).map((value) => ({ value, label: `#${value}` }));
const publicationOptions = publications.map((p) => ({ value: p.id, label: p.name }));
---

<BaseLayout title="Archive" description="Every article on The Rack, filterable by publication, format and tag.">
  <Container>
    <PageHero title="Back" highlight="issues." lede="Every article ever filed. Filter the stack down to what you need." />
    <Newsprint title="The Rack Daily" subtitle={`Archive edition · ${listings.length} articles`}>
      <ArchiveFilters target="archive-list" publications={publicationOptions} formats={formats} tags={tags} />
      <ArticleList id="archive-list" listings={listings} />
    </Newsprint>
  </Container>
</BaseLayout>
