---
import type { GetStaticPaths } from "astro";
import IssueDocument from "../../../components/issue/IssueDocument.astro";
import { getIssues } from "../../../lib/content/issues";
import { byRunningOrder, getPostsForIssue } from "../../../lib/content/posts";
import { requirePublication } from "../../../lib/content/publications";
import type { Issue } from "../../../lib/content/types";
export const getStaticPaths = (async () =>
  (await getIssues()).map((issue) => ({
    params: { publicationId: issue.publicationId, issueSlug: issue.slug },
    props: { issue },
  }))) satisfies GetStaticPaths;
interface Props {
  issue: Issue;
}
const { issue } = Astro.props;
const publication = await requirePublication(issue.publicationId);
const posts = (await getPostsForIssue(publication.id, issue.slug)).sort(
  byRunningOrder,
);
---

<IssueDocument issue={issue} publication={publication} posts={posts} />
