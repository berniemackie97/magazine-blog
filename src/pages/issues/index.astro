---
import RackFrame from "../../components/rack/RackFrame.astro";
import Shelf from "../../components/rack/Shelf.astro";
import Awning from "../../components/site/Awning.astro";
import Container from "../../components/site/Container.astro";
import PageHero from "../../components/site/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicationShelves } from "../../lib/content/rack";
import { urls } from "../../lib/urls";

const shelves = await getPublicationShelves({ featuredOnly: false });
const issueCount = shelves.reduce((sum, shelf) => sum + shelf.items.length, 0);
---

<BaseLayout title="Every issue" description="Every issue of every publication on The Rack.">
  <Awning />
  <Container>
    <PageHero
      title="The whole"
      highlight="rack."
      lede={`${issueCount} ${issueCount === 1 ? "issue" : "issues"} across ${shelves.length} publications. Hover to pull one out, click to open it.`}
    />
    <RackFrame>
      {
        shelves.map(({ publication, items }) => (
          <Shelf
            id={publication.id}
            label={publication.name}
            note={publication.kicker}
            items={items}
            moreHref={urls.publication(publication.id)}
          />
        ))
      }
    </RackFrame>
  </Container>
</BaseLayout>
